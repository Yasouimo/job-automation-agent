    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.content;\n\n// Find where the JSON object actually starts and ends\nconst startIndex = text.indexOf('{');\nconst endIndex = text.lastIndexOf('}');\n\nif (startIndex === -1 || endIndex === -1) {\n  throw new Error(\"Could not find a valid JSON object in the AI's response.\");\n}\n\n// Slice out only the pure JSON text between { and }\nconst jsonString = text.substring(startIndex, endIndex + 1);\nconst data = JSON.parse(jsonString);\n\n// Pull the company name from the form trigger\nconst form = $('Form Trigger1').first().json;\ndata.COMPANY = form.Company_Name || form['Company Name'] || data.COMPANY || '';\n\nreturn { json: data };"
      },
