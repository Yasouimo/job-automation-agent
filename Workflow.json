        "messages": {
          "values": [
            {
              "content": "You are an expert tech recruiter. Analyze the BASELINE CV TEXT and JOB DESCRIPTION. Output a single flat JSON object (no markdown). The output keys must EXACTLY match: TARGET_JOB_TITLE, TAILORED_SUMMARY, VINCI_B1, VINCI_B2, VINCI_B3, VINCI_B4, DECLIC_B1, DECLIC_B2, DECLIC_B3, RADEM_B1, RADEM_B2, PROJET_TEST_B1, PROJET_TEST_B2, PROJET_PLAGIAT_B1, PROJET_PLAGIAT_B2, PROJET_MULTI_B1, PROJET_MULTI_B2, SUBJECT, GREETING, PARAGRAPH_1, PARAGRAPH_2, PARAGRAPH_3, CLOSING, CITY, DATE. \n\nCRITICAL: Keep all CV bullets strictly under 115 characters.",
              "role": "system"
            },
            {
              "content": "=COMPANY: {{ $items(\"Form Trigger\")[0].json.Company_Name }}\n\nJOB DESCRIPTION:\n{{ $items(\"Form Trigger\")[0].json.Job_Description }}\n\nBASELINE CV:\n{{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "name": "Generate Content",
      "typeVersion": 1.2,
      "position": [
        -96,
        320
      ],
      "id": "fa6c149e-2b8a-40ab-afa3-e4dfffa0f378",
